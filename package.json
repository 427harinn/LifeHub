{
  "name": "lifehub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "cf:dev": "vite build && wrangler dev --local --config dist/lifehub/wrangler.json --persist-to .wrangler/state --port 5173",
    "cf:dev:m2": "npm run db:migrate:local && npm run cf:dev",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "test:unit": "vitest run --maxWorkers=1",
    "test:e2e": "playwright test",
    "test:e2e:m2": "playwright test e2e/m2-auth-navigation.spec.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "5.20260907.1",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
