{
  "manifest": {
    "name": "LifeHub",
    "short_name": "LifeHub",
    "description": "生活の予定・お金・記録をひとつの時間軸で扱うアプリ",
    "id": "/",
    "start_url": "/calendar",
    "display": "standalone",
    "background_color": "#fcfbf7",
    "theme_color": "#f2a766",
    "lang": "ja",
    "icons": [
      {
        "src": "/icons/app/lifehub-192.png",
        "sizes": "192x192",
        "type": "image/png",
        "purpose": "any"
      },
      {
        "src": "/icons/app/lifehub-512.png",
        "sizes": "512x512",
        "type": "image/png",
        "purpose": "maskable"
      }
    ]
  },
  "icons": [
    {
      "path": "/icons/app/lifehub.svg",
      "ok": true,
      "contentType": "image/svg+xml"
    },
    {
      "path": "/icons/app/lifehub-192.png",
      "ok": true,
      "contentType": "image/png"
    },
    {
      "path": "/icons/app/lifehub-512.png",
      "ok": true,
      "contentType": "image/png"
    },
    {
      "path": "/icons/app/apple-touch-icon.png",
      "ok": true,
      "contentType": "image/png"
    }
  ]
}